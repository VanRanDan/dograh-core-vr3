# lago-dev .env — copy to .env on the Dockge host and fill in real secrets.
# The real .env lives ONLY on the box: /mnt/.ix-apps/app_mounts/dockge/stacks/lago-dev/.env
# Generate secrets:
#   openssl rand -hex 16   (passwords / encryption keys)
#   openssl rand -hex 64   (SECRET_KEY_BASE)
#   openssl genrsa 2048 | base64 -w0   (LAGO_RSA_PRIVATE_KEY)
#   uuidgen                (LAGO_ORG_API_KEY)

# --- Postgres ---
POSTGRES_USER=lago
POSTGRES_DB=lago
POSTGRES_PASSWORD=__rand_hex_16__

# --- Rails / encryption ---
SECRET_KEY_BASE=__rand_hex_64__
LAGO_RSA_PRIVATE_KEY=__base64_of_openssl_genrsa_2048__
LAGO_ENCRYPTION_PRIMARY_KEY=__rand_hex_16__
LAGO_ENCRYPTION_DETERMINISTIC_KEY=__rand_hex_16__
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=__rand_hex_16__

# --- URLs (macvlan IPs on the VR3 LAN) ---
LAGO_API_URL=http://192.11.0.39:3000
LAGO_FRONT_URL=http://192.11.0.40

# --- First-boot org seed (creates org + admin user + API key) ---
LAGO_CREATE_ORG=true
LAGO_ORG_NAME=VR3AI
LAGO_ORG_USER_EMAIL=dc.nieves@gmail.com
LAGO_ORG_USER_PASSWORD=__rand_hex_12__
LAGO_ORG_API_KEY=__uuid__
LAGO_DISABLE_SIGNUP=true
